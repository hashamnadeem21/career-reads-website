# ─────────────────────────────────────────────────────────────────────────────
# Career Reads (careersreads.com) environment configuration
# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, add these under Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are embedded in the browser bundle at BUILD time —
# never put secrets in them. Rebuild/redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for canonical URLs, Open Graph,
# sitemap.xml, robots.txt, RSS and JSON-LD.
# In production: https://careersreads.com (or https://www.careersreads.com,
# whichever you choose as the main address; redirect the other one to it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact address shown on the site (the admin's Settings can override it).
# Create this mailbox at your domain/email host before launch.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# ── Career Reads API (blognest-api) ──────────────────────────────────────────
# When set, articles, authors, jobs, categories and settings come from the API;
# otherwise from the files in content/. Local: http://localhost:4000
# Vercel production deployments default to https://api-careersreads.com when this is empty.
API_URL=
# Sent to the API as X-Api-Key (forms, page counters, draft previews).
# Same value as SITE_API_KEY in the API. Generate with: openssl rand -hex 32
SITE_API_KEY=
# Same value as REVALIDATE_SECRET in the API. The API calls /api/revalidate with it after saves.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ── Search engine verification (optional) ────────────────────────────────────
# Google Search Console → Add property → HTML tag → copy only the `content` value.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Google Analytics 4 (optional) ────────────────────────────────────────────
# Format: G-XXXXXXXXXX. Loaded only in production builds.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Google AdSense (optional) ────────────────────────────────────────────────
# Your publisher ID from AdSense → Account → Account information (ca-pub-…).
# Setting it adds the google-adsense-account meta tag and serves /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Ads load ONLY when this is true AND it's a production build AND the client ID is set.
NEXT_PUBLIC_ADS_ENABLED=false
# Ad unit (slot) IDs from AdSense → Ads → By ad unit. A placement without one renders nothing.
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
# Development only: dashed boxes where ads would appear.
NEXT_PUBLIC_ADS_SHOW_PLACEHOLDERS=false

# ── Content ──────────────────────────────────────────────────────────────────
# Development only: render `status: draft` articles locally (ignored in production).
CONTENT_PREVIEW_DRAFTS=false

# ── Contact form delivery via Resend (server-only secrets) ───────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "Career Reads <contact@careersreads.com>"
CONTACT_FROM_EMAIL=

# ── Newsletter (server-only) ─────────────────────────────────────────────────
# Signups are POSTed as JSON { email, source, subscribedAt } to this URL.
NEWSLETTER_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>".
NEWSLETTER_WEBHOOK_SECRET=
